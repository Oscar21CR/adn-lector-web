<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ arquetipo.nombre }} · ADN Lector</title>
<meta name="description" content="{{ arquetipo.insight }}">

<!-- Open Graph: para que el link se vea bien al compartir por WhatsApp/redes -->
<meta property="og:title" content="{{ arquetipo.nombre }} · ADN Lector">
<meta property="og:description" content="{{ arquetipo.insight }}">
<meta property="og:type" content="website">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,300;1,9..144,400;1,9..144,600&family=Manrope:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --color-cream: #FBF6EC;
    --color-cream-mid: #F0E8D5;
    --color-ink: #1F1A17;
    --color-terracotta: #B85C38;
    --color-forest: #2F5D50;
    --color-indigo: #313866;
    --color-gold: #C79A3B;
    --color-plum: #6E3A59;
    --color-coffee: #6B4226;
    --font-display: 'Fraunces', Georgia, serif;
    --font-body: 'Manrope', system-ui, sans-serif;
    --font-mono: 'IBM Plex Mono', 'Courier New', monospace;
  }

  * { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; box-sizing: border-box; }
  html { scroll-behavior: auto; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  body { font-family: var(--font-body); background-color: var(--color-cream); color: var(--color-ink); margin: 0; }

  /* ============ Utilities ============ */
  .adn-sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .adn-skip-link {
    position: absolute; left: 12px; top: -60px; background: var(--color-terracotta); color: var(--color-cream);
    font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.06em; padding: 10px 18px;
    border-radius: 2px; z-index: 300; transition: top 0.2s ease; text-decoration: none;
  }
  .adn-skip-link:focus { top: 12px; }

  /* ============ Book-spines animation ============ */
  .adn-spines { display: flex; align-items: flex-end; justify-content: center; height: 118px; margin-bottom: 28px; gap: 10px; }
  .adn-spine {
    width: 34px; border-radius: 7px 7px 3px 3px; box-shadow: 0 10px 18px -10px rgba(31, 26, 23, 0.35);
    opacity: 0; transform: translateY(16px) rotate(var(--adn-rot, 0deg)); animation: adn-rise 0.6s ease forwards;
  }
  .adn-spine:nth-child(1) { background: var(--color-plum);       --adn-rot: -6deg; height: 88px;  animation-delay: 0.05s; }
  .adn-spine:nth-child(2) { background: var(--color-terracotta); --adn-rot: -2deg; height: 108px; animation-delay: 0.12s; }
  .adn-spine:nth-child(3) { background: var(--color-forest);     --adn-rot: 0deg;  height: 118px; animation-delay: 0.19s; }
  .adn-spine:nth-child(4) { background: var(--color-indigo);     --adn-rot: 3deg;  height: 100px; animation-delay: 0.26s; }
  .adn-spine:nth-child(5) { background: var(--color-gold);       --adn-rot: 7deg;  height: 84px;  animation-delay: 0.33s; }
  @keyframes adn-rise { to { opacity: 1; transform: translateY(0) rotate(var(--adn-rot, 0deg)); } }
  @media (prefers-reduced-motion: reduce) {
    .adn-spine { animation: none; opacity: 1; transform: rotate(var(--adn-rot, 0deg)); }
  }

  /* ============ Sidebar / hamburger menu ============ */
  .adn-sidebar {
    position: fixed; left: 0; top: 0; bottom: 0; width: 82%; max-width: 300px; background: var(--color-ink);
    z-index: 200; display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden;
    transform: translateX(-100%); transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .adn-sidebar.open { transform: translateX(0); box-shadow: 8px 0 48px rgba(0, 0, 0, 0.45); }
  @media (max-width: 380px) { .adn-sidebar { width: 90%; } }

  .adn-backdrop {
    position: fixed; inset: 0; background: rgba(31, 26, 23, 0.6); z-index: 199;
    opacity: 0; pointer-events: none; transition: opacity 0.28s ease;
  }
  .adn-backdrop.open { opacity: 1; pointer-events: auto; }

  /* Layout-only — color/border/shadow go inline in the HTML below, on purpose:
     a plain `button { background: none }` reset later in this file has higher
     CSS specificity than a bare class rule and will silently win otherwise. */
  .adn-hamburger {
    position: fixed; top: 16px; left: 16px; z-index: 198; cursor: pointer; min-width: 44px; height: 44px;
    padding: 0 14px; display: flex; align-items: center; justify-content: center; gap: 9px; border-radius: 4px;
  }
  .adn-hamburger-lines { display: flex; flex-direction: column; gap: 5px; flex-shrink: 0; }
  .adn-hamburger-label { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }

  .adn-sb-brand { display: flex; flex-direction: column; align-items: flex-start; padding: 22px 20px 18px; border-bottom: 1px solid rgba(251, 246, 236, 0.07); }
  .adn-sb-navitem {
    width: 100%; display: flex; align-items: center; justify-content: flex-start; gap: 12px; padding: 12px 20px;
    border: none; cursor: pointer; transition: background 0.16s, border-color 0.16s; text-align: left;
    border-left: 2px solid transparent; background: transparent; min-height: 44px;
  }
  .adn-sb-navitem.active { background: rgba(184,92,56,0.14); border-left-color: var(--color-terracotta); }
  .adn-sb-navitem .icon { font-family: var(--font-mono); font-size: 15px; color: rgba(251,246,236,0.55); flex-shrink: 0; min-width: 18px; text-align: center; }
  .adn-sb-navitem.active .icon { color: var(--color-terracotta); }
  .adn-sb-navitem .label { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(251,246,236,0.58); white-space: nowrap; }
  .adn-sb-navitem.active .label { color: rgba(251,246,236,0.9); }
  .adn-sb-footer { border-top: 1px solid rgba(251, 246, 236, 0.07); padding: 16px 20px; display: flex; align-items: center; }
  .adn-sb-close { display: flex; }

  .adn-main { margin-left: 0; }

  /* ============ Hero ============ */
  .adn-hero-content { padding: 72px 32px 56px; }

  /* ============ Patrones: horizontal scroll on mobile ============ */
  .adn-patrones-track {
    display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
    padding-bottom: 10px; margin: 0 -48px; padding-left: 48px; padding-right: 48px;
  }
  .adn-patrones-track > * { flex: 0 0 78%; scroll-snap-align: start; }
  .adn-patrones-nav { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
  .adn-patrones-arrow {
    width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 20px; line-height: 1; cursor: pointer; transition: opacity 0.15s ease;
  }
  .adn-patrones-arrow:disabled { cursor: default; }

  .adn-books-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  .adn-plan-detail { display: grid; grid-template-columns: 1fr 1px 1fr; }
  .hero-lower-grid { display: grid; grid-template-columns: 1fr; gap: 28px; }

  /* ============ Back-to-top ============ */
  .adn-back-to-top {
    position: fixed; right: 18px; bottom: 18px; z-index: 150; width: 46px; height: 46px; border-radius: 50%;
    cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 18px;
    opacity: 0; pointer-events: none; transform: translateY(8px); transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .adn-back-to-top.visible { opacity: 1; pointer-events: auto; transform: translateY(0); }

  /* ============ Purchase links on book cards ============ */
  .adn-buy-links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
  .adn-buy-link {
    display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 12.5px;
    letter-spacing: 0.04em; text-decoration: none; padding: 8px 14px; border-radius: 100px;
    border: 1px solid var(--color-line, #E4D7BF);
  }

  @media (min-width: 768px) {
    .adn-sidebar { width: 224px; transform: none; transition: none; box-shadow: none !important; }
    .adn-sidebar.open { box-shadow: none !important; }
    .adn-hamburger { display: none; }
    .adn-backdrop { display: none !important; }
    .adn-sb-close { display: none; }
    .adn-main { margin-left: 224px; }
    .adn-hero-content { padding: 80px 64px 72px; }
    .hero-lower-grid { grid-template-columns: 55fr 45fr; gap: 52px; }
    .adn-books-grid { grid-template-columns: repeat(3, 1fr); }
    .adn-patrones-track { display: grid; grid-template-columns: repeat(3, 1fr); overflow-x: visible; margin: 0; padding-left: 0; padding-right: 0; }
    .adn-patrones-track > * { flex: unset; }
    .adn-patrones-nav { display: none; }
  }

  ::-webkit-scrollbar { width: 3px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #E4D7BF; border-radius: 2px; }

  /* Reset default button chrome. Any button needing a visible background
     MUST set it inline in the markup — inline styles always beat this rule. */
  button { background: none; border: none; font: inherit; color: inherit; cursor: pointer; }
  a { color: inherit; }
</style>
</head>
<body>

<a href="#main-content" class="adn-skip-link">Saltar al contenido</a>

<button
  id="adn-hamburger"
  class="adn-hamburger"
  aria-label="Abrir menú de navegación"
  aria-expanded="false"
  aria-controls="adn-sidebar"
  style="background: var(--color-coffee); border: 1px solid rgba(251, 246, 236, 0.22); box-shadow: 0 4px 16px rgba(31, 26, 23, 0.32);"
>
  <span class="adn-hamburger-lines" aria-hidden="true">
    <span style="display:block;width:18px;height:1.5px;background:#FBF6EC;border-radius:1px;"></span>
    <span style="display:block;width:18px;height:1.5px;background:#FBF6EC;border-radius:1px;"></span>
    <span style="display:block;width:18px;height:1.5px;background:#FBF6EC;border-radius:1px;"></span>
  </span>
  <span class="adn-hamburger-label" style="color:#FBF6EC;">Menú</span>
</button>

<div id="adn-backdrop" class="adn-backdrop" aria-hidden="true"></div>

<aside id="adn-sidebar" class="adn-sidebar" aria-label="Navegación del reporte">
  <div class="adn-sb-brand">
    <div style="display:flex;justify-content:space-between;align-items:center;width:100%;margin-bottom:6px;">
      <span style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-gold);font-weight:500;">ADN Lector</span>
      <button id="adn-sb-close" class="adn-sb-close" aria-label="Cerrar menú"
        style="background:none;border:none;cursor:pointer;color:rgba(251,246,236,0.75);font-family:var(--font-body);font-size:24px;line-height:1;width:44px;height:44px;padding:0;display:flex;align-items:center;justify-content:center;">
        ×
      </button>
    </div>
    <span style="font-family:var(--font-body);font-size:14px;color:rgba(251,246,236,0.4);line-height:1;">{{ usuario.nombre }}</span>
  </div>

  <nav style="flex:1;padding:8px 0;" aria-label="Secciones del reporte">
    <button class="adn-sb-navitem active" data-nav-target="portada">
      <span class="icon">◎</span><span class="label">Portada</span>
      <span class="adn-sr-only current-marker">(sección actual)</span>
    </button>
    <button class="adn-sb-navitem" data-nav-target="patrones">
      <span class="icon">◈</span><span class="label">Patrones</span>
      <span class="adn-sr-only current-marker" hidden>(sección actual)</span>
    </button>
    <button class="adn-sb-navitem" data-nav-target="contraportada">
      <span class="icon">❧</span><span class="label">Contraportada</span>
      <span class="adn-sr-only current-marker" hidden>(sección actual)</span>
    </button>
    <button class="adn-sb-navitem" data-nav-target="libros">
      <span class="icon">▦</span><span class="label">Libros</span>
      <span class="adn-sr-only current-marker" hidden>(sección actual)</span>
    </button>
    <button class="adn-sb-navitem" data-nav-target="ruta">
      <span class="icon">⟶</span><span class="label">Ruta emocional</span>
      <span class="adn-sr-only current-marker" hidden>(sección actual)</span>
    </button>
    <button class="adn-sb-navitem" data-nav-target="plan">
      <span class="icon">◷</span><span class="label">Plan lector</span>
      <span class="adn-sr-only current-marker" hidden>(sección actual)</span>
    </button>
    <button class="adn-sb-navitem" data-nav-target="cierre">
      <span class="icon">◆</span><span class="label">Cierre</span>
      <span class="adn-sr-only current-marker" hidden>(sección actual)</span>
    </button>
  </nav>

  <div class="adn-sb-footer">
    <span style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.08em;color:rgba(251,246,236,0.2);text-transform:uppercase;">{{ fecha_generado }}</span>
  </div>
</aside>

<main id="main-content" tabindex="-1" class="adn-main">

  <!-- ============ PORTADA ============ -->
  <section id="portada" style="background:#FBF6EC;min-height:100svh;display:flex;flex-direction:column;">
    <div class="adn-hero-content" style="flex:1;display:flex;flex-direction:column;">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:20px;flex-wrap:wrap;gap:8px;">
        <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.18em;text-transform:uppercase;color:var(--color-terracotta);">ADN Lector</span>
        <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.06em;color:#7A6B62;">{{ usuario.nombre }}</span>
      </div>

      <div style="height:1.5px;background:var(--color-gold);margin-bottom:40px;"></div>

      <div class="adn-spines" aria-hidden="true">
        <div class="adn-spine"></div>
        <div class="adn-spine"></div>
        <div class="adn-spine"></div>
        <div class="adn-spine"></div>
        <div class="adn-spine"></div>
      </div>

      <div style="flex:1;display:flex;flex-direction:column;justify-content:center;margin-bottom:52px;background:#F0E8D5;border:1px solid #E4D7BF;border-left:3px solid var(--color-terracotta);border-radius:2px;padding:40px 44px;">
        <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.14em;text-transform:uppercase;color:#7A6B62;margin-bottom:18px;display:block;">Tu arquetipo</span>
        <h1 style="font-family:var(--font-display);font-size:clamp(34px, 7vw, 76px);font-weight:300;line-height:1.02;color:#1F1A17;font-style:italic;letter-spacing:-0.025em;margin:0 0 32px;">{{ arquetipo.nombre }}</h1>
        <p style="font-family:var(--font-body);font-size:16px;font-weight:300;line-height:1.8;color:#4A3F38;margin:0 0 22px;">{{ arquetipo.descripcion }}</p>
        <div style="height:1px;background:#DCCBA8;margin-bottom:22px;"></div>
        <p style="font-family:var(--font-display);font-size:18px;font-style:italic;font-weight:300;line-height:1.55;color:var(--color-terracotta);margin:0;">"{{ arquetipo.insight }}"</p>
      </div>

      <div>
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="height:1px;width:22px;background:var(--color-gold);"></div>
          <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.08em;color:#6B5E57;">{{ fecha_generado }}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PATRONES ============ -->
  {% set patron_colors = ['#2F5D50', '#313866', '#6E3A59'] %}
  {% set patron_symbols = ['◈', '◉', '◍'] %}
  <section id="patrones" aria-label="02 · Patrones de lectura" style="background:#1F1A17;padding:80px 48px;">
    <div style="max-width:1000px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:36px;">
        <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.1em;color:rgba(199,154,59,0.75);white-space:nowrap;">02 · Patrones de lectura</span>
        <div style="flex:1;height:1px;background:rgba(199,154,59,0.75);opacity:0.18;"></div>
      </div>
      <h2 style="font-family:var(--font-display);font-size:clamp(26px, 4vw, 40px);font-weight:300;font-style:italic;line-height:1.15;color:#FBF6EC;margin-bottom:52px;max-width:520px;">Cómo leés, más allá de lo que leés</h2>

      <div id="adn-patrones-track" class="adn-patrones-track">
        {% for patron in patrones %}
        {% set color = patron_colors[loop.index0 % patron_colors|length] %}
        {% set symbol = patron_symbols[loop.index0 % patron_symbols|length] %}
        <div style="background:{{ color }};padding:40px 32px 36px;position:relative;overflow:hidden;border-radius:2px;">
          <span aria-hidden="true" style="position:absolute;right:-8px;top:-28px;font-family:var(--font-display);font-size:140px;font-weight:700;color:rgba(251,246,236,0.07);line-height:1;user-select:none;pointer-events:none;">0{{ loop.index }}</span>
          <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.14em;color:rgba(251,246,236,0.5);display:block;margin-bottom:28px;">0{{ loop.index }}</span>
          <p style="font-family:var(--font-display);font-size:clamp(17px, 2.2vw, 21px);font-style:italic;font-weight:300;line-height:1.55;color:#FBF6EC;margin-bottom:32px;position:relative;z-index:1;">{{ patron }}</p>
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="height:1px;flex:1;background:rgba(251,246,236,0.15);"></div>
            <span style="font-family:var(--font-mono);font-size:16px;color:rgba(251,246,236,0.55);">{{ symbol }}</span>
          </div>
        </div>
        {% endfor %}
      </div>

      <div class="adn-patrones-nav">
        <button id="adn-patrones-prev" class="adn-patrones-arrow" aria-label="Ver patrón anterior" disabled
          style="background:var(--color-coffee);color:#FBF6EC;border:1px solid rgba(251,246,236,0.22);opacity:0.35;">‹</button>
        <button id="adn-patrones-next" class="adn-patrones-arrow" aria-label="Ver patrón siguiente"
          style="background:var(--color-coffee);color:#FBF6EC;border:1px solid rgba(251,246,236,0.22);opacity:1;">›</button>
      </div>
    </div>
  </section>

  <!-- ============ CONTRAPORTADA ============ -->
  <section id="contraportada" aria-label="03 · La contraportada de tu vida" style="background:#FBF6EC;padding:80px 48px;">
    <div style="max-width:660px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:36px;">
        <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.1em;color:var(--color-forest);white-space:nowrap;">03 · La contraportada de tu vida</span>
        <div style="flex:1;height:1px;background:var(--color-forest);opacity:0.18;"></div>
      </div>
      <h2 style="font-family:var(--font-display);font-size:clamp(26px, 5vw, 42px);font-weight:300;font-style:italic;line-height:1.12;color:#1F1A17;margin-bottom:32px;">{{ contraportada.titulo }}</h2>
      <div style="border-left:3px solid var(--color-forest);padding-left:28px;">
        <p style="font-family:var(--font-body);font-size:17px;font-weight:300;line-height:1.85;color:#4A3F38;margin:0;">{{ contraportada.descripcion }}</p>
      </div>
      <div style="margin-top:48px;display:flex;align-items:center;gap:14px;">
        <div style="height:1px;width:22px;background:var(--color-gold);"></div>
        <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.08em;color:#6B5E57;">{{ usuario.nombre }} · {{ fecha_generado }}</span>
      </div>
    </div>
  </section>

  <!-- ============ LIBROS ============ -->
  {% set book_colors = [
    {'bg': '#2F5D50', 'text': '#FBF6EC', 'muted': 'rgba(184,212,205,0.85)'},
    {'bg': '#313866', 'text': '#FBF6EC', 'muted': 'rgba(192,197,224,0.85)'},
    {'bg': '#6E3A59', 'text': '#FBF6EC', 'muted': 'rgba(220,192,213,0.85)'}
  ] %}
  <section id="libros" aria-label="04 · Tus libros recomendados" style="background:#F0E8D5;padding:80px 48px;">
    <div style="max-width:1000px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:36px;">
        <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.1em;color:var(--color-indigo);white-space:nowrap;">04 · Tus libros recomendados</span>
        <div style="flex:1;height:1px;background:var(--color-indigo);opacity:0.18;"></div>
      </div>
      <h2 style="font-family:var(--font-display);font-size:clamp(24px, 4vw, 36px);font-weight:300;font-style:italic;color:#1F1A17;line-height:1.15;margin:0 0 16px;">Tres libros elegidos para vos</h2>
      <p style="font-family:var(--font-body);font-size:15px;font-weight:300;line-height:1.7;color:#6B5E57;max-width:560px;margin:0 0 44px;">{{ libros.criterio }}</p>

      <div class="adn-books-grid" style="align-items:stretch;">
        {% for libro in libros['items'] %}
        {% set scheme = book_colors[loop.index0 % book_colors|length] %}
        <article style="background:#FBF6EC;border:1px solid #E4D7BF;border-radius:2px;display:flex;flex-direction:column;height:100%;overflow:hidden;box-shadow:0 2px 16px rgba(31,26,23,0.06);">
          <div style="background:{{ scheme.bg }};padding:24px 24px 22px;position:relative;overflow:hidden;min-height:148px;display:flex;flex-direction:column;justify-content:space-between;">
            <span aria-hidden="true" style="position:absolute;right:-6px;bottom:-20px;font-family:var(--font-display);font-size:110px;font-weight:700;color:rgba(251,246,236,0.07);line-height:1;user-select:none;pointer-events:none;">{{ libro.orden }}</span>
            <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.14em;color:{{ scheme.muted }};display:block;">0{{ libro.orden }}</span>
            <div style="position:relative;z-index:1;">
              <h3 style="font-family:var(--font-display);font-size:clamp(18px, 2.5vw, 21px);font-weight:400;font-style:italic;color:{{ scheme.text }};line-height:1.15;margin-bottom:8px;">{{ libro.titulo }}</h3>
              <p style="font-family:var(--font-body);font-size:14px;font-weight:500;color:{{ scheme.muted }};letter-spacing:0.03em;margin:0;">{{ libro.autor }}</p>
            </div>
          </div>
          <div style="padding:14px 24px;display:flex;gap:10px;align-items:center;border-bottom:1px solid #E4D7BF;flex-wrap:wrap;">
            <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:{{ scheme.bg }};background:{{ scheme.bg }}18;padding:4px 10px;border-radius:1px;">{{ libro.genero }}</span>
            {% if libro.paginas %}<span style="font-family:var(--font-mono);font-size:14px;color:#6B5E57;">{{ libro.paginas }} págs.</span>{% endif %}
          </div>
          <div style="padding:20px 24px;border-bottom:1px solid #E4D7BF;">
            <p style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:#6B5E57;margin-bottom:10px;">Lo que pediste</p>
            <p style="font-family:var(--font-display);font-size:15px;font-style:italic;font-weight:300;line-height:1.6;color:#4A3F38;margin:0;">"{{ libro.frase_usuario }}"</p>
          </div>
          <div style="padding:20px 24px;flex:1;">
            <p style="font-family:var(--font-body);font-size:14px;font-weight:300;line-height:1.8;color:#1F1A17;margin:0;">{{ libro.justificacion }}</p>

            {% if libro.links_compra and (libro.links_compra.kindle or libro.links_compra.fisico) %}
            <div class="adn-buy-links">
              {% if libro.links_compra.kindle %}
              <a class="adn-buy-link" href="{{ libro.links_compra.kindle }}" target="_blank" rel="noopener"
                 style="color:{{ scheme.bg }};border-color:{{ scheme.bg }}40;">
                📖 Kindle
              </a>
              {% endif %}
              {% if libro.links_compra.fisico and libro.links_compra.fisico.url %}
              <a class="adn-buy-link" href="{{ libro.links_compra.fisico.url }}" target="_blank" rel="noopener"
                 style="color:{{ scheme.bg }};border-color:{{ scheme.bg }}40;">
                📕 Físico{% if libro.links_compra.fisico.precio %} · {{ libro.links_compra.fisico.precio }}{% endif %}
              </a>
              {% endif %}
            </div>
            {% endif %}
          </div>
          <div style="background:#F0E8D5;padding:16px 24px;display:flex;gap:10px;align-items:flex-start;">
            <span style="color:var(--color-gold);font-size:14px;margin-top:2px;flex-shrink:0;">◆</span>
            <p style="font-family:var(--font-body);font-size:14px;font-weight:400;line-height:1.65;color:#4A3F38;font-style:italic;margin:0;">{{ libro.nota_lectura }}</p>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ============ RUTA EMOCIONAL ============ -->
  {% set step_colors = ['#2F5D50', '#313866', '#6E3A59'] %}
  <section id="ruta" aria-label="05 · Ruta emocional de lectura" style="background:#FBF6EC;padding:80px 48px;">
    <div style="max-width:660px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:36px;">
        <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.1em;color:var(--color-plum);white-space:nowrap;">05 · Ruta emocional de lectura</span>
        <div style="flex:1;height:1px;background:var(--color-plum);opacity:0.18;"></div>
      </div>
      <p style="font-family:var(--font-body);font-size:16px;font-weight:300;line-height:1.8;color:#4A3F38;font-style:italic;margin-bottom:52px;">{{ ruta_emocional.intro }}</p>
      <div style="position:relative;">
        <div style="position:absolute;left:15px;top:16px;bottom:16px;width:1px;background:linear-gradient(to bottom, #2F5D50, #313866, #6E3A59);opacity:0.3;"></div>
        {% for item in ruta_emocional['items'] %}
        {% set color = step_colors[loop.index0 % step_colors|length] %}
        <div style="display:flex;gap:28px;align-items:flex-start;{% if not loop.last %}padding-bottom:48px;{% endif %}">
          <div style="width:32px;height:32px;border-radius:50%;background:{{ color }};flex-shrink:0;display:flex;align-items:center;justify-content:center;position:relative;z-index:1;box-shadow:0 0 0 4px #FBF6EC;">
            <span style="font-family:var(--font-mono);font-size:14px;color:#FBF6EC;font-weight:500;">{{ loop.index }}</span>
          </div>
          <div style="padding-top:3px;">
            <p style="font-family:var(--font-display);font-size:20px;font-weight:400;color:#1F1A17;margin-bottom:8px;">{{ item.libro }}</p>
            <p style="font-family:var(--font-body);font-size:15px;font-weight:300;line-height:1.75;color:#4A3F38;">{{ item.transicion }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ============ PLAN DE LECTURA ============ -->
  <section id="plan" aria-label="06 · Plan de lectura" style="background:#1F1A17;padding:80px 48px;">
    <div style="max-width:760px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:36px;">
        <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.1em;color:rgba(199,154,59,0.75);white-space:nowrap;">06 · Plan de lectura</span>
        <div style="flex:1;height:1px;background:rgba(199,154,59,0.75);opacity:0.18;"></div>
      </div>
      <p style="font-family:var(--font-body);font-size:16px;font-weight:300;line-height:1.8;color:rgba(251,246,236,0.6);font-style:italic;margin-bottom:48px;">{{ plan_lectura.intro }}</p>

      <div style="margin-bottom:52px;">
        <div style="display:grid;grid-template-columns:repeat({{ plan_lectura['items']|length }}, 1fr);gap:4px;margin-bottom:8px;">
          {% for item in plan_lectura['items'] %}
          <div style="height:8px;background:{{ step_colors[loop.index0 % step_colors|length] }};border-radius:2px;opacity:0.82;"></div>
          {% endfor %}
        </div>
        <div style="display:flex;gap:20px;flex-wrap:wrap;">
          {% for item in plan_lectura['items'] %}
          <div style="display:flex;align-items:center;gap:8px;">
            <div style="width:20px;height:4px;background:{{ step_colors[loop.index0 % step_colors|length] }};border-radius:2px;"></div>
            <span style="font-family:var(--font-body);font-size:14px;font-weight:300;color:rgba(251,246,236,0.5);">{{ item.libro }}</span>
          </div>
          {% endfor %}
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:16px;">
        {% for item in plan_lectura['items'] %}
        {% set color = step_colors[loop.index0 % step_colors|length] %}
        <div style="border-radius:2px;overflow:hidden;border:1px solid rgba(251,246,236,0.07);">
          <div style="background:{{ color }};padding:20px 28px;display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;">
            <div>
              <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.12em;color:rgba(251,246,236,0.55);display:block;margin-bottom:6px;">Semanas {{ item.semanas }}</span>
              <p style="font-family:var(--font-display);font-size:20px;font-style:italic;font-weight:300;color:#FBF6EC;line-height:1.1;margin:0;">{{ item.libro }}</p>
            </div>
            {% set filled = ((item.paginas_sesion / 20) * 10) | round | int %}
            <div style="display:flex;flex-direction:column;gap:6px;">
              <div style="display:flex;gap:3px;">
                {% for i in range(10) %}
                <div style="width:18px;height:6px;border-radius:1px;background:{% if i < filled %}rgba(251,246,236,0.85){% else %}rgba(251,246,236,0.15){% endif %};"></div>
                {% endfor %}
              </div>
              <span style="font-family:var(--font-mono);font-size:14px;color:rgba(251,246,236,0.55);letter-spacing:0.06em;">{{ item.paginas_sesion }} págs / sesión</span>
            </div>
          </div>
          <div class="adn-plan-detail" style="background:#232018;">
            <div style="padding:20px 28px;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                <span style="font-family:var(--font-mono);font-size:15px;color:rgba(199,154,59,0.75);">◷</span>
                <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.08em;text-transform:uppercase;color:rgba(251,246,236,0.6);">Cuándo</span>
              </div>
              <p style="font-family:var(--font-body);font-size:15px;font-weight:400;color:rgba(251,246,236,0.82);line-height:1.55;margin:0;">{{ item.momento }}</p>
            </div>
            <div style="background:rgba(251,246,236,0.06);"></div>
            <div style="padding:20px 28px;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                <span style="font-family:var(--font-mono);font-size:15px;color:rgba(199,154,59,0.75);">◆</span>
                <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.08em;text-transform:uppercase;color:rgba(251,246,236,0.6);">Cómo</span>
              </div>
              <p style="font-family:var(--font-body);font-size:15px;font-weight:300;font-style:italic;line-height:1.65;color:rgba(251,246,236,0.82);margin:0;">{{ item.condicion }}</p>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ============ CIERRE ============ -->
  <section id="cierre" aria-label="07 · Cierre" style="background:#FBF6EC;padding:88px 48px 80px;position:relative;overflow:hidden;">
    <div aria-hidden="true" style="position:absolute;bottom:-100px;left:-80px;font-family:var(--font-display);font-size:clamp(200px, 40vw, 380px);font-weight:700;color:transparent;-webkit-text-stroke:1px rgba(31,26,23,0.04);line-height:1;user-select:none;pointer-events:none;">∞</div>
    <div style="max-width:660px;margin:0 auto;position:relative;z-index:1;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:36px;">
        <span style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.1em;color:var(--color-terracotta);white-space:nowrap;">07 · Cierre</span>
        <div style="flex:1;height:1px;background:var(--color-terracotta);opacity:0.18;"></div>
      </div>
      <p style="font-family:var(--font-display);font-size:clamp(22px, 4vw, 36px);font-weight:300;font-style:italic;line-height:1.5;color:#1F1A17;margin-bottom:56px;">"{{ cierre }}"</p>
      <div style="height:1px;background:#E4D7BF;margin-bottom:44px;"></div>
      <p style="font-family:var(--font-body);font-size:16px;font-weight:300;line-height:1.75;color:#4A3F38;margin-bottom:28px;">{{ viral.texto }}</p>
      <a href="{{ viral.link_formulario }}" target="_blank" rel="noopener"
         style="display:inline-block;background:var(--color-terracotta);color:#FBF6EC;font-family:var(--font-mono);font-size:14px;letter-spacing:0.14em;text-transform:uppercase;text-decoration:none;padding:16px 36px;border-radius:1px;">
        Hacé tu ADN Lector →
      </a>
      <p style="font-family:var(--font-mono);font-size:14px;letter-spacing:0.08em;color:#6B5E57;margin-top:60px;text-transform:uppercase;">ADN Lector · {{ usuario.nombre }} · {{ fecha_generado }}</p>
    </div>
  </section>

</main>

<button id="adn-back-to-top" class="adn-back-to-top" aria-label="Volver arriba" tabindex="-1"
  style="background:var(--color-coffee);color:#FBF6EC;border:1px solid rgba(251,246,236,0.22);box-shadow:0 4px 18px rgba(31,26,23,0.32);">
  ↑
</button>

<script>
(function () {
  var hamburger = document.getElementById('adn-hamburger');
  var sidebar = document.getElementById('adn-sidebar');
  var backdrop = document.getElementById('adn-backdrop');
  var closeBtn = document.getElementById('adn-sb-close');
  var main = document.getElementById('main-content');
  var navItems = Array.prototype.slice.call(sidebar.querySelectorAll('.adn-sb-navitem'));
  var sections = navItems.map(function (btn) {
    return document.getElementById(btn.getAttribute('data-nav-target'));
  });
  var menuOpen = false;

  function setActive(id) {
    navItems.forEach(function (btn) {
      var isActive = btn.getAttribute('data-nav-target') === id;
      btn.classList.toggle('active', isActive);
      if (isActive) { btn.setAttribute('aria-current', 'true'); } else { btn.removeAttribute('aria-current'); }
      var marker = btn.querySelector('.current-marker');
      if (marker) { marker.hidden = !isActive; }
    });
  }

  function openMenu() {
    menuOpen = true;
    sidebar.classList.add('open');
    backdrop.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
    hamburger.setAttribute('aria-label', 'Cerrar menú de navegación');
    main.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = 'hidden';
    var focusable = sidebar.querySelectorAll('button, a[href]');
    if (focusable.length) { focusable[0].focus(); }
    document.addEventListener('keydown', onKeyDown);
  }

  function closeMenu() {
    menuOpen = false;
    sidebar.classList.remove('open');
    backdrop.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
    hamburger.setAttribute('aria-label', 'Abrir menú de navegación');
    main.removeAttribute('aria-hidden');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKeyDown);
    hamburger.focus();
  }

  function onKeyDown(e) {
    if (e.key === 'Escape') { closeMenu(); return; }
    if (e.key !== 'Tab') return;
    var focusable = sidebar.querySelectorAll('button, a[href]');
    if (!focusable.length) return;
    var first = focusable[0], last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  hamburger.addEventListener('click', function () { menuOpen ? closeMenu() : openMenu(); });
  closeBtn.addEventListener('click', closeMenu);
  backdrop.addEventListener('click', closeMenu);
  navItems.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = document.getElementById(btn.getAttribute('data-nav-target'));
      if (target) target.scrollIntoView({ behavior: 'smooth' });
      closeMenu();
    });
  });

  // Scrollspy
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    }, { threshold: 0.3 });
    sections.forEach(function (el) { if (el) io.observe(el); });
  }

  // Back-to-top
  var backToTop = document.getElementById('adn-back-to-top');
  window.addEventListener('scroll', function () {
    var show = window.scrollY > window.innerHeight * 0.6;
    backToTop.classList.toggle('visible', show);
    backToTop.tabIndex = show ? 0 : -1;
  }, { passive: true });
  backToTop.addEventListener('click', function () {
    document.getElementById('portada').scrollIntoView({ behavior: 'smooth' });
  });

  // Patrones: prev/next arrows
  var track = document.getElementById('adn-patrones-track');
  var prevBtn = document.getElementById('adn-patrones-prev');
  var nextBtn = document.getElementById('adn-patrones-next');
  function updateArrows() {
    var canPrev = track.scrollLeft > 4;
    var canNext = track.scrollLeft < track.scrollWidth - track.clientWidth - 4;
    prevBtn.disabled = !canPrev; prevBtn.style.opacity = canPrev ? '1' : '0.35';
    nextBtn.disabled = !canNext; nextBtn.style.opacity = canNext ? '1' : '0.35';
  }
  function scrollByCard(direction) {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    track.scrollBy({ left: track.clientWidth * 0.85 * direction, behavior: reduceMotion ? 'auto' : 'smooth' });
  }
  prevBtn.addEventListener('click', function () { scrollByCard(-1); });
  nextBtn.addEventListener('click', function () { scrollByCard(1); });
  track.addEventListener('scroll', updateArrows, { passive: true });
  window.addEventListener('resize', updateArrows);
  updateArrows();
})();
</script>

</body>
</html>
